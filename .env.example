# ==============================================================================
# PraveenMart Environment Configuration Template (.env.example)
# Copy this file to .env and configure the values for your environment.
# DO NOT commit the actual .env file or real secrets to version control.
# ==============================================================================

# Database Configuration (H2 server or file mode)
DB_URL=jdbc:h2:~/praveenmart;AUTO_SERVER=TRUE;MODE=LEGACY
DB_USER=sa
DB_PASSWORD=

# AI Chatbot Configuration (Section 11 & 17)
# Provider options: "gemini" (for live Google Gemini LLM API) or "mock" (offline canned FAQ answers)
AI_CHATBOT_PROVIDER=mock

# Google Gemini API Key (Required only if AI_CHATBOT_PROVIDER is set to "gemini")
# Kept strictly server-side; never exposed to client-side assets
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Server Port (Optional override)
PORT=8083
