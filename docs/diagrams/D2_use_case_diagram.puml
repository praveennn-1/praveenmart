@startuml PraveenMart_UseCase_Diagram
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "Buyer" as buyer
actor "Seller" as seller
actor "Admin" as admin

rectangle "PraveenMart E-Commerce Marketplace" {
  ' Common authentication
  usecase "Register & Login\n(Role: Buyer / Seller)" as UC_Auth
  usecase "View Profile & Session" as UC_Profile
  
  ' Buyer Use Cases (F1, F3, F4, F5, F6, F8, O1, O4)
  usecase "Browse Catalog & Categories" as UC_Browse
  usecase "Search & Filter Products" as UC_Search
  usecase "Add / Update / Remove Cart Items" as UC_Cart
  usecase "Manage Wishlist / Save-for-Later (O1)" as UC_Wishlist
  usecase "Checkout with Mock Payment (F5)" as UC_Checkout
  usecase "View Order History & Tracking (F6)" as UC_BuyerOrders
  usecase "Submit Star Rating & Review (F8)" as UC_Review
  usecase "Interact with AI Shopping Assistant (O4)" as UC_Chatbot

  ' Seller Use Cases (F2, F6, O2, O3)
  usecase "Create Product Listing" as UC_CreateProduct
  usecase "Edit / Update Product Listing" as UC_EditProduct
  usecase "Delete Product Listing" as UC_DeleteProduct
  usecase "View Incoming Orders for Products (F6)" as UC_SellerOrders
  usecase "Update Order Status Lifecycle (O2)\n(Pending -> Confirmed -> Shipped -> Delivered)" as UC_StatusUpdate
  usecase "View Sales Analytics & Revenue Dashboard (O3)" as UC_SellerDashboard

  ' Admin Use Cases (F1, F7)
  usecase "Seed Admin Login (admin@praveenmart.com)" as UC_AdminLogin
  usecase "View All Users & Role Distribution" as UC_ViewUsers
  usecase "Moderate & Delete Users" as UC_ModUsers
  usecase "View All Orders & Platform Revenue" as UC_ViewOrders
  usecase "Moderate / Remove Any Product Listing" as UC_ModListings
}

' Buyer associations
buyer --> UC_Auth
buyer --> UC_Profile
buyer --> UC_Browse
buyer --> UC_Search
buyer --> UC_Cart
buyer --> UC_Wishlist
buyer --> UC_Checkout
buyer --> UC_BuyerOrders
buyer --> UC_Review
buyer --> UC_Chatbot

' Seller associations
seller --> UC_Auth
seller --> UC_Profile
seller --> UC_CreateProduct
seller --> UC_EditProduct
seller --> UC_DeleteProduct
seller --> UC_SellerOrders
seller --> UC_StatusUpdate
seller --> UC_SellerDashboard

' Admin associations
admin --> UC_AdminLogin
admin --> UC_ViewUsers
admin --> UC_ModUsers
admin --> UC_ViewOrders
admin --> UC_ModListings

@enduml
