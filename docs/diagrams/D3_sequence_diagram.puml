@startuml PraveenMart_Sequence_Diagram
!theme plain
autonumber

actor "Buyer (Browser)" as Browser
participant "AuthFilter" as Filter
participant "CheckoutServlet" as Servlet
participant "OrderService" as Service
participant "PaymentStrategy\n(Mock Payment)" as Strategy
participant "OrderDAO" as OrderDAO
participant "CartDAO" as CartDAO
participant "ProductDAO" as ProductDAO
database "H2 Database\n(HikariCP Pool)" as DB

Browser -> Filter: POST /checkout (address, paymentMethod="COD"|"CARD"|"UPI")
activate Filter
Filter -> Filter: Verify active session & role != ADMIN
Filter -> Servlet: Forward authorized request
activate Servlet

Servlet -> Service: placeOrder(buyerId, address, paymentMethod)
activate Service

Service -> CartDAO: findByUserId(buyerId)
activate CartDAO
CartDAO -> DB: SELECT * FROM cart_items WHERE user_id = ?
DB --> CartDAO: List<CartItem>
CartDAO --> Service: cartItems
deactivate CartDAO

Service -> Service: Validate cart not empty & compute total

loop For each item in cart
  Service -> ProductDAO: findById(productId)
  activate ProductDAO
  ProductDAO -> DB: SELECT * FROM products WHERE id = ?
  DB --> ProductDAO: Product
  ProductDAO --> Service: Product (check stockQty >= quantity)
  deactivate ProductDAO
end

Service -> Strategy: processPayment(orderId, totalAmount, paymentDetails)
activate Strategy
Strategy --> Service: PaymentResult(success = true)
deactivate Strategy

Service -> DB: conn = DBUtil.getConnection(); conn.setAutoCommit(false)
activate DB

Service -> OrderDAO: createOrder(conn, order)
activate OrderDAO
OrderDAO -> DB: INSERT INTO orders(buyer_id, status, total_amount) VALUES (?, 'CONFIRMED', ?)
DB --> OrderDAO: generated order_id
OrderDAO --> Service: orderId
deactivate OrderDAO

loop For each CartItem
  Service -> OrderDAO: createOrderItem(conn, orderItem)
  activate OrderDAO
  OrderDAO -> DB: INSERT INTO order_items(order_id, product_id, quantity, unit_price)
  deactivate OrderDAO

  Service -> OrderDAO: deductProductStock(conn, productId, quantity)
  activate OrderDAO
  OrderDAO -> DB: UPDATE products SET stock_qty = stock_qty - ? WHERE id = ? AND stock_qty >= ?
  deactivate OrderDAO
end

Service -> CartDAO: clearCart(buyerId)
activate CartDAO
CartDAO -> DB: DELETE FROM cart_items WHERE user_id = ?
deactivate CartDAO

Service -> DB: conn.commit()
deactivate DB

Service --> Servlet: Order (status='CONFIRMED', id=orderId)
deactivate Service

Servlet -> Servlet: session.setAttribute("lastOrder", order)
Servlet --> Browser: HTTP 302 Redirect to /order_success.jsp?orderId=orderId
deactivate Servlet
deactivate Filter

Browser -> Browser: Render Order Success Confirmation Page

@enduml
