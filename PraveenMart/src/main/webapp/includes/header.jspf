<%@ page pageEncoding="UTF-8" %>
<%@ page import="com.praveen.praveenmart.model.User" %>
<%@ page import="com.praveen.praveenmart.service.CartService" %>
<%
    User sessionUser = (User) session.getAttribute("user");
    int cartCount = 0;
    if (sessionUser != null) {
        try {
            CartService headerCartService = new CartService();
            cartCount = headerCartService.getCartItemCount(sessionUser.getId());
        } catch (Exception ignored) {}
    }
%>
<header class="site-header">
    <div class="container">
        <div class="nav-bar">
            <!-- Left Group: Brand Logo with Cloud Mark -->
            <div class="nav-left">
                <!-- Brand Logo (Pure Typography Wordmark) -->
                <a href="<%= (sessionUser != null && "ADMIN".equalsIgnoreCase(sessionUser.getRole())) ? request.getContextPath() + "/admin/dashboard" : request.getContextPath() + "/products" %>" class="brand-logo">
                    <span>PraveenMart</span>
                </a>
            </div>

            <!-- Center Navigation Links -->
            <nav class="nav-center-links" aria-label="Main Navigation">
                <a href="<%= request.getContextPath() %>/products" class="nav-link active">Home</a>
                <a href="<%= request.getContextPath() %>/products?category=Electronics" class="nav-link">Electronics</a>
                <a href="<%= request.getContextPath() %>/products?category=Fashion%20%26%20Style" class="nav-link">Fashion</a>
                <a href="<%= request.getContextPath() %>/products?category=Home%20%26%20Kitchen" class="nav-link">Home & Kitchen</a>
                <a href="<%= request.getContextPath() %>/products?category=Accessories" class="nav-link">Accessories</a>
                <a href="<%= request.getContextPath() %>/products?category=Books" class="nav-link">Books</a>
            </nav>

            <!-- Right Actions: Cart + Pill Action + Right-Corner Menu -->
            <div class="nav-actions">
                <!-- Cart Button -->
                <% if (sessionUser == null || !"ADMIN".equalsIgnoreCase(sessionUser.getRole())) { %>
                    <a href="<%= request.getContextPath() %>/cart" class="nav-icon-btn" id="navCartBtn" title="Shopping Cart">
                        <span class="material-symbols-outlined" style="font-size: 1.25rem;">shopping_bag</span>
                        <span class="nav-badge-count" id="navCartBadge" <%= cartCount > 0 ? "" : "style=\"display: none;\"" %>><%= cartCount %></span>
                    </a>
                <% } %>

                <!-- User Session / Action Pill Button -->
                <% if (sessionUser != null) { %>
                    <a href="<%= request.getContextPath() %>/dashboard.jsp" class="btn btn-secondary btn-pill" style="padding: 0.45rem 1rem; font-size: 0.85rem;" title="<%= sessionUser.getEmail() %>">
                        <span class="material-symbols-outlined" style="font-size: 1.1rem; color: #ffffff;">account_circle</span>
                        <span><%= sessionUser.getName() %></span>
                    </a>
                    <a href="<%= request.getContextPath() %>/logout" class="btn btn-outlined btn-pill" style="padding: 0.45rem 0.9rem; font-size: 0.82rem;">
                        <span>Sign Out</span>
                    </a>
                <% } else { %>
                    <a href="<%= request.getContextPath() %>/login.jsp" class="btn btn-primary btn-pill" style="padding: 0.5rem 1.35rem; font-size: 0.88rem;">
                        <span>Sign in</span>
                    </a>
                    <a href="<%= request.getContextPath() %>/register.jsp" class="btn btn-secondary btn-pill" style="padding: 0.5rem 1.1rem; font-size: 0.88rem;">
                        <span>Register</span>
                    </a>
                <% } %>

                <!-- Dropdown Menu Trigger (Right Corner) -->
                <div class="menu-dropdown-wrapper" id="menuDropdownWrapper">
                    <button type="button" class="menu-toggle-btn" id="menuToggleBtn" aria-label="Toggle navigation menu" aria-expanded="false" title="Menu">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect y="2.5" width="18" height="2.2" rx="1.1" fill="#FFFFFF"/>
                            <rect y="7.9" width="18" height="2.2" rx="1.1" fill="#FFFFFF"/>
                            <rect y="13.3" width="18" height="2.2" rx="1.1" fill="#FFFFFF"/>
                        </svg>
                    </button>
                    <div class="menu-dropdown-card" id="menuDropdownCard" role="menu">
                        <% if (sessionUser == null || !"ADMIN".equalsIgnoreCase(sessionUser.getRole())) { %>
                            <a href="<%= request.getContextPath() %>/products" class="menu-dropdown-item" role="menuitem">
                                <span class="material-symbols-outlined">storefront</span>
                                <span>Shop Collection</span>
                            </a>
                            <a href="<%= request.getContextPath() %>/orders" class="menu-dropdown-item" role="menuitem">
                                <span class="material-symbols-outlined">receipt_long</span>
                                <span>My Orders</span>
                            </a>
                        <% } %>
                        <% if (sessionUser != null) { %>
                            <% if ("SELLER".equalsIgnoreCase(sessionUser.getRole())) { %>
                                <a href="<%= request.getContextPath() %>/seller/dashboard" class="menu-dropdown-item" role="menuitem">
                                    <span class="material-symbols-outlined">store</span>
                                    <span>Seller Hub</span>
                                </a>
                            <% } %>
                            <% if ("ADMIN".equalsIgnoreCase(sessionUser.getRole()) && "admin@praveenmart.com".equalsIgnoreCase(sessionUser.getEmail())) { %>
                                <a href="<%= request.getContextPath() %>/admin/dashboard" class="menu-dropdown-item" role="menuitem" style="color: #fbbf24;">
                                    <span class="material-symbols-outlined" style="color: #fbbf24;">admin_panel_settings</span>
                                    <span>Admin Panel</span>
                                </a>
                            <% } %>
                        <% } %>
                        <a href="<%= request.getContextPath() %>/cart" class="menu-dropdown-item" role="menuitem">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            <span>Shopping Cart</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    (function() {
        const toggleBtn = document.getElementById('menuToggleBtn');
        const dropdownCard = document.getElementById('menuDropdownCard');
        const wrapper = document.getElementById('menuDropdownWrapper');

        if (!toggleBtn || !dropdownCard) return;

        function toggleMenu(e) {
            e.stopPropagation();
            const isOpen = dropdownCard.classList.contains('show');
            if (isOpen) {
                closeMenu();
            } else {
                openMenu();
            }
        }

        function openMenu() {
            dropdownCard.classList.add('show');
            toggleBtn.classList.add('active');
            toggleBtn.setAttribute('aria-expanded', 'true');
        }

        function closeMenu() {
            dropdownCard.classList.remove('show');
            toggleBtn.classList.remove('active');
            toggleBtn.setAttribute('aria-expanded', 'false');
        }

        toggleBtn.addEventListener('click', toggleMenu);

        document.addEventListener('click', function(e) {
            if (wrapper && !wrapper.contains(e.target)) {
                closeMenu();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeMenu();
            }
        });
    })();
</script>
