<%@ page pageEncoding="UTF-8" %>
<footer class="site-footer">
    <div class="container">
        <div class="footer-main">
            <!-- Col 1: Brand & Bio -->
            <div>
                <div class="brand-logo" style="margin-bottom: 1.2rem;">
                    <span>PraveenMart</span>
                </div>
                <p style="color: var(--color-on-surface-variant); font-size: 0.92rem; max-width: 360px; line-height: 1.65; margin-bottom: 1.5rem;">
                    Your trusted modern destination for high-quality electronics, trending fashion, kitchen essentials, and daily lifestyle accessories.
                </p>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span class="badge-tag" style="background: rgba(255,255,255,0.06); color: #ffffff; border: 1px solid rgba(255,255,255,0.12);">
                        <span class="material-symbols-outlined" style="font-size: 0.85rem; color: #C8B196;">verified</span>
                        <span>100% Genuine Products</span>
                    </span>
                </div>
            </div>

            <!-- Col 2: Categories -->
            <div>
                <h4 class="footer-col-title">Categories</h4>
                <ul class="footer-links-list">
                    <li><a href="<%= request.getContextPath() %>/products">All Products</a></li>
                    <li><a href="<%= request.getContextPath() %>/products?category=Electronics">Electronics</a></li>
                    <li><a href="<%= request.getContextPath() %>/products?category=Fashion%20%26%20Style">Fashion & Style</a></li>
                    <li><a href="<%= request.getContextPath() %>/products?category=Home%20%26%20Kitchen">Home & Kitchen</a></li>
                    <li><a href="<%= request.getContextPath() %>/products?category=Accessories">Accessories</a></li>
                </ul>
            </div>

            <!-- Col 3: Customer Care -->
            <div>
                <h4 class="footer-col-title">Customer Care</h4>
                <ul class="footer-links-list">
                    <li><a href="<%= request.getContextPath() %>/orders">Track Orders</a></li>
                    <li><a href="<%= request.getContextPath() %>/cart">Shopping Cart</a></li>
                    <li><a href="<%= request.getContextPath() %>/dashboard.jsp">Account Dashboard</a></li>
                    <li><a href="#">Shipping & Returns</a></li>
                    <li><a href="#">Help & Support</a></li>
                </ul>
            </div>

            <!-- Col 4: Newsletter -->
            <div>
                <h4 class="footer-col-title">Stay Connected</h4>
                <p style="color: var(--color-on-surface-variant); font-size: 0.88rem; margin-bottom: 1.1rem;">
                    Subscribe to get notified about new arrivals, flash deals, and exclusive member discounts.
                </p>
                <form action="#" method="post" onsubmit="event.preventDefault(); alert('Thank you for subscribing to PraveenMart updates!');" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 180px; position: relative;">
                        <input type="email" placeholder="Enter your email" required
                               style="width: 100%; padding: 0.65rem 1rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: var(--radius-pill); color: #ffffff; font-size: 0.88rem; outline: none;">
                    </div>
                    <button type="submit" class="btn btn-primary btn-pill" style="padding: 0.65rem 1.3rem; font-size: 0.86rem;">
                        <span>Subscribe</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="footer-bottom">
            <div>
                &copy; <%= java.time.Year.now().getValue() %> PraveenMart. All rights reserved.
            </div>
            <div style="display: flex; gap: 1.5rem;">
                <a href="#" style="color: var(--color-on-surface-muted); font-size: 0.85rem;">Privacy Policy</a>
                <a href="#" style="color: var(--color-on-surface-muted); font-size: 0.85rem;">Terms of Service</a>
                <a href="#" style="color: var(--color-on-surface-muted); font-size: 0.85rem;">Security</a>
            </div>
        </div>
    </div>
</footer>

<!-- PraveenMart AI Chatbot Widget (Week 9 Deliverable) -->
<link rel="stylesheet" href="<%= request.getContextPath() %>/css/chat-widget.css?v=1.0">

<div id="pmChatWidgetRoot">
    <!-- Floating Launcher Trigger Button -->
    <button type="button" class="pm-chat-launcher" id="pmChatLauncher" aria-label="Open AI Shopping Assistant" title="Chat with PraveenMart AI Assistant">
        <div class="pm-chat-launcher-icon">
            <span class="material-symbols-outlined">auto_awesome</span>
            <span class="pm-chat-launcher-pulse"></span>
        </div>
        <span class="pm-chat-launcher-label">Ask AI</span>
    </button>

    <!-- Floating Chat Window Panel -->
    <div class="pm-chat-panel" id="pmChatPanel" role="dialog" aria-labelledby="pmChatTitle" aria-modal="false">
        <div class="pm-chat-header">
            <div class="pm-chat-header-info">
                <div class="pm-chat-avatar">
                    <span class="material-symbols-outlined">smart_toy</span>
                </div>
                <div>
                    <h3 class="pm-chat-title" id="pmChatTitle">PraveenMart AI</h3>
                    <div class="pm-chat-status">
                        <span class="pm-status-dot"></span>
                        <span>Shopping Assistant • Online</span>
                    </div>
                </div>
            </div>
            <div class="pm-chat-header-actions">
                <button type="button" class="pm-chat-icon-btn" id="pmChatClearBtn" title="Reset Conversation" aria-label="Reset Conversation">
                    <span class="material-symbols-outlined" style="font-size: 1.15rem;">refresh</span>
                </button>
                <button type="button" class="pm-chat-icon-btn" id="pmChatCloseBtn" title="Close Chat" aria-label="Close Chat">
                    <span class="material-symbols-outlined" style="font-size: 1.15rem;">close</span>
                </button>
            </div>
        </div>

        <!-- Chat Conversation Messages -->
        <div class="pm-chat-body" id="pmChatBody" role="log" aria-live="polite"></div>

        <!-- Chat Input Form -->
        <div class="pm-chat-footer">
            <form id="pmChatForm" class="pm-chat-form" autocomplete="off">
                <div class="pm-chat-input-box">
                    <input type="text" id="pmChatInput" class="pm-chat-input" placeholder="Ask about products, orders, returns..." maxlength="500" required>
                    <button type="submit" id="pmChatSendBtn" class="pm-chat-send-btn" title="Send Message" aria-label="Send Message">
                        <span class="material-symbols-outlined">send</span>
                    </button>
                </div>
                <div class="pm-chat-meta-bar">
                    <span>Restricted to product & store inquiries</span>
                    <span id="pmChatCharCount">0/500</span>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.contextPath = '<%= request.getContextPath() %>';
</script>
<script src="<%= request.getContextPath() %>/js/chat-widget.js?v=1.0"></script>

